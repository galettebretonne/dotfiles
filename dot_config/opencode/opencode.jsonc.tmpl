{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./palantir-proxy.ts"],
  "mcp": {
    "openscad": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--with",
        "git+https://github.com/quellant/openscad-mcp.git",
        "openscad-mcp"
      ],
      "enabled": true,
      "environment": {
        "OPENSCAD_PATH": "/usr/bin/openscad",
        "MCP_ALLOWED_PATHS": "{{ .chezmoi.homeDir }}/Develop/discovery861"
      }
    },
    "palantir": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "set -a; . {{ .chezmoi.homeDir }}/Develop/palantir-chat/.env; set +a; exec npx -y palantir-mcp --foundry-api-url \"https://$FOUNDRY_HOST\""
      ],
      "enabled": true
    }
  },
  "provider": {
    "pchat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Palantir (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8788/v1",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "palantir-agent": {
          "name": "Palantir Agent",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": { "context": 150000, "output": 32000 }
        },
        "palantir-fast": {
          "name": "Palantir Fast (RID factice)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": { "context": 150000, "output": 32000 }
        },
        "palantir-smart": {
          "name": "Palantir Smart (RID factice)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": { "context": 150000, "output": 32000 }
        }
      }
    }
  }
}
